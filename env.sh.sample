# Sample env file to set JAVA_HOME for macOS zsh
# Copy to env.sh and edit the path to match your JDK installation, then `source env.sh` or add to ~/.zshrc

# Example (edit this path to your JDK 24 installation):
export JAVA_HOME="/Library/Java/JavaVirtualMachines/your-jdk-24.jdk/Contents/Home"
export PATH="$JAVA_HOME/bin:$PATH"

# Verify:
# java -version
# javac -version

